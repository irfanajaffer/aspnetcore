@page "/dispatch-exception-after-dispose"

<PageTitle>DispatchExceptionAsync after renderer disposal</PageTitle>

<h1>DispatchExceptionAsync after renderer disposal</h1>

<p>
    Click the button, then close the browser tab (or navigate away so the circuit is torn down) within
    5 seconds. The background task calls <code>DispatchExceptionAsync</code> after the renderer was disposed.
    Before the fix, the server logs an unhandled <code>ArgumentException: The renderer does not have a
    component with ID ...</code>. After the fix, nothing is thrown.
</p>

<button id="start-background-work" class="btn btn-primary" @onclick="StartBackgroundWork" disabled="@_running">Start background work</button>

<p id="status">@_status</p>

@code {
    private bool _running;
    private string _status = "Idle";

    private void StartBackgroundWork()
    {
        _running = true;
        _status = "Loading...";
        _ = BackgroundWork();
    }

    private async Task BackgroundWork()
    {
        try
        {
            await Task.Delay(5000);
            throw new InvalidOperationException("Background failure");
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }
}
